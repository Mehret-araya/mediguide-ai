# Copy this file to .env and provide your own local database URL.
PORT=5000
FRONTEND_URL=http://localhost:5173
# Supabase Auth credentials. Keep the service-role key server-side and private.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# TLS verifies the server certificate by default. Use false only for local PostgreSQL.
DATABASE_SSL=true
# Optional CA certificate path for a database using a private CA.
DATABASE_SSL_CA=
